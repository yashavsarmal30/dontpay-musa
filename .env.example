# .env.example — copy to .env and fill in your values

# SQLite database location (default: ~/.exam_mcp/papers.db)
EXAM_DB_PATH=

# Transport: "stdio" for Claude Desktop, "streamable-http" for HTTP clients
MCP_TRANSPORT=stdio

# LLM API Keys (all optional — used only for fuzzy topic grouping)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
